# ===== Режим =====
# true = тільки шукає можливості й пише в лог, жодних реальних угод
DRY_RUN=true

# ===== Пара =====
BASE_ASSET=ETH
QUOTE_ASSET=USDC
CEX_SYMBOL=ETHUSDC

# ===== Binance (ключ БЕЗ права виводу! + whitelist IP) =====
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# taker комісія (0.001 = 0.1%; з BNB-знижкою 0.00075)
CEX_TAKER_FEE=0.001

# ===== Блокчейн (Arbitrum One) =====
CHAIN_ID=42161
# Бажано власна нода або платний RPC (Alchemy/QuickNode) — це головний фактор швидкості
RPC_HTTP_URL=https://arb1.arbitrum.io/rpc
RPC_WS_URL=
PRIVATE_KEY=
# Uniswap V3 (адреси для Arbitrum/Ethereum/Optimism/Polygon)
UNI_QUOTER_V2=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
UNI_SWAP_ROUTER02=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
UNI_POOL_FEE=500
# WETH / USDC (native) на Arbitrum
BASE_TOKEN=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
BASE_DECIMALS=18
QUOTE_TOKEN=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
QUOTE_DECIMALS=6
# Оцінка газу на один своп (одиниці газу)
SWAP_GAS_UNITS=200000
AUTO_APPROVE=true

# ===== Стратегія =====
# Мінімальний чистий прибуток після ВСІХ комісій і газу
MIN_PROFIT_USD=2
MIN_PROFIT_BPS=8
# Розміри угоди в quote-валюті (USDC): бот перебирає сітку і бере найприбутковішу
MIN_TRADE_QUOTE=200
MAX_TRADE_QUOTE=5000
SIZE_STEPS=6
# Допустиме проковзування на DEX відносно котирування
DEX_SLIPPAGE_BPS=10
TX_DEADLINE_SEC=30
# Переоцінка, якщо ціна на CEX змістилася більше ніж на N bps (крім кожного нового блоку)
REEVAL_ON_CEX_MOVE_BPS=2
# Книга CEX вважається застарілою, якщо оновлень не було довше
CEX_STALE_MS=1500

# ===== Ризик =====
MAX_DAILY_LOSS_USD=50
MAX_CONSECUTIVE_FAILURES=3
# Мінімальні залишки, нижче яких напрям угод вимикається
MIN_BASE_RESERVE=0.01
MIN_QUOTE_RESERVE=20
# Кулдаун після кожної угоди
TRADE_COOLDOWN_MS=1500

# ===== Сповіщення (необов'язково) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
