# Секрети. Решта налаштувань — у config.json (скопіюй з config.example.json)

# Один EVM-гаманець для всіх мереж. ОКРЕМИЙ, лише під бота.
# Краще: ключ у файлі поза репозиторієм з chmod 600
PRIVATE_KEY_FILE=
# або (гірше) прямо тут:
PRIVATE_KEY=

# RPC по мережах (бажано платні: Alchemy / QuickNode / dRPC)
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_BSC=https://bsc-dataseed.bnbchain.org

# Біржі. Права: торгівля + вивід. Вивід ТІЛЬКИ на whitelist-адресу гаманця бота. Прив'язка ключа до IP.
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
BYBIT_API_KEY=
BYBIT_SECRET=
GATE_API_KEY=
GATE_SECRET=
KUCOIN_API_KEY=
KUCOIN_SECRET=
KUCOIN_PASSWORD=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=

# Необов'язково
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
KYBER_CLIENT_ID=arb-bot
LOG_LEVEL=info

# Додаткові мережі (порожні — мережа вимкнеться: прибери її з config.json)
RPC_BASE=https://mainnet.base.org
RPC_POLYGON=https://polygon-rpc.com
RPC_OPTIMISM=https://mainnet.optimism.io

# Необов'язково: ключі агрегаторів / CoinGecko (вищі ліміти)
ODOS_API_KEY=
COINGECKO_API_KEY=
