{
  "name": "dex-cex-arb-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DEX <-> CEX arbitrage bot (Uniswap V3 on Arbitrum <-> Binance spot)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test test/*.test.ts",
    "discover": "tsx src/tools/discover.ts",
    "selftest": "tsx src/tools/selftest.ts"
  },
  "dependencies": {
    "ccxt": "^4.5.93",
    "dotenv": "^18.0.10",
    "viem": "^2.58.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
