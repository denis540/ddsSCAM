# paper = симуляція (ордери НЕ ставляться), live = реальна торгівля
MODE=paper
# true = тестові мережі бірж (Binance, Bybit, OKX, BingX, Kraken) з тестовими ключами — реальні ордери на тестові гроші
SANDBOX=false
# Тестове середовище кожної біржі (за замовчуванням: Binance — Futures Testnet, Bybit — Demo Trading,
# OKX/Bitget — Demo, BingX — VST, Kraken — demo-futures). Для Binance Demo Trading замість Testnet:
# TESTENV_BINANCE=demo

# Kraken Futures за замовчуванням угод не дає (масштаб ставок на реальних даних не підтверджено).
# Довіряти його ставкам після перевірки: TRUST_RATES=kraken
TRUST_RATES=

# Біржі через кому. Підтримуються: binance, bybit, htx (huobi), okx, bitget, kucoin, bingx, kraken
# Дані (ставки, стакани) беруться з усіх. Торгівля (MODE=live) — лише між біржами, де є API-ключі.
EXCHANGES=binance,bybit,htx,okx,bitget,kucoin,bingx,kraken
QUOTE=USDT

# API-ключі. Права: лише торгівля ф'ючерсами, БЕЗ права на виведення! Бажано прив'язати до IP сервера.
# Ключі також можна додати прямо в Telegram: /setkey okx <apiKey> <secret> <passphrase>
BINANCE_API_KEY=
BINANCE_SECRET=

BYBIT_API_KEY=
BYBIT_SECRET=

HTX_API_KEY=
HTX_SECRET=

OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=          # passphrase

BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=       # passphrase

KUCOIN_API_KEY=        # ключ KuCoin з правами Futures
KUCOIN_SECRET=
KUCOIN_PASSWORD=       # passphrase

BINGX_API_KEY=
BINGX_SECRET=

KRAKEN_API_KEY=        # ключі саме від Kraken FUTURES (futures.kraken.com), не від спотового Kraken
KRAKEN_SECRET=

# --- Розмір і ризик ---
# auto  — бот дивиться стакани обох бірж (вхід і вихід), вільну маржу і заходить на максимально можливу суму,
#         але не більше MAX_TRADE_USDT. Розмір зменшується, якщо великий обсяг погіршує ціну/профіт.
# coins — вхід і вихід фіксованою КІЛЬКІСТЮ МОНЕТ (COIN_QTY), usdt — фіксованою сумою POSITION_USDT
SIZE_MODE=auto
MAX_TRADE_USDT=100         # ВАША СУМА (маржа) на 1 угоду на кожній біржі; позиція = сума × плече (якщо стакани дозволяють)
MIN_TRADE_USDT=20          # якщо стакани дозволяють позицію меншу за це — не заходити
CHECK_EXIT_DEPTH=true      # враховувати і стакан на вихід
COIN_QTY=                  # BTC:0.002,ETH:0.05 — у coins: точна кількість; в auto: макс. кількість цієї монети
POSITION_USDT=100          # номінал КОЖНОЇ ноги (для SIZE_MODE=usdt)
LEVERAGE=3                 # бажане плече; фактичне однакове на обох біржах і не більше максимуму кожної біржі для монети
MARGIN_MODE=isolated
MAX_POSITIONS=3

# --- Вхід (під конкретну виплату фандінгу) ---
MIN_FUNDING_PCT=0.1        # ВХІД лише якщо фандінг за виплату(и) більший за цей %. Напр. OKX 3% vs Binance 1% = 2%
MIN_PROFIT_PCT=0.05        # і чистий профіт після 4 тейкер-комісій більший за цей %
ENTRY_BEFORE_SEC=120       # заходити приблизно за 2 хв до виплати
ENTRY_MIN_SEC=20           # якщо до виплати менше — вже не заходимо
MAX_WINDOW_HOURS=8         # якщо виплати на біржах у різний час — макс. годин між ними (0 = лише одна/одночасні)
ALLOW_ESTIMATED=true       # враховувати проміжні виплати швидшої біржі (1h) за поточною ставкою
LOOKAHEAD_HOURS=8          # горизонт для /top
MAX_ENTRY_BASIS_PCT=0.15   # макс. несприятлива різниця цін між біржами на вході
BASIS_COST=true            # true: несприятлива різниця цін на вході віднімається з прибутку (вхід лише якщо фандінг її покриває)
                           # false: не віднімати — бот розраховує вийти приблизно на тій самій різниці (ризикованіше)
MAX_SLIPPAGE_PCT=0.1       # макс. відхилення середньої ціни виконання від найкращої в стакані (на кожній нозі)
MAX_ABS_FUNDING_RATE_PCT=10  # ставки більші за це — вважаємо аномалією
DEFAULT_TAKER_FEE_PCT=0.05

# --- Вихід ---
EXIT_AFTER_SEC=5           # через 5 с після (останньої) виплати бот починає шукати точку виходу (перевірка кожні 5 с)
CONVERGE_PCT=0.05          # ...або одразу, як різниця цін між біржами ≤ 0.05% («зійшлися»)
EARLY_EXIT=true            # вийти ще ДО виплати, якщо ціни зійшлися і прибуток від цін уже більший за фандінг
SETTLE_DELAY_SEC=5         # не закриватися раніше ніж через 5 с після виплати (live ще й чекає підтвердження нарахування)
MAX_CONVERGE_WAIT_MIN=30   # якщо після виплати вихід у мінус — чекати сходження цін до N хв (але не до наступної виплати)

# --- Захист коштів ---
ORDER_TYPE=auto            # auto: бот сам — лімітний IOC з межею ціни (звичайні входи/виходи) або ринковий (термінові); market: завжди ринкові
LIQ_CLOSE_PCT=60           # бот закриває пару, коли ціна пройшла 60% шляху від входу до ліквідації будь-якої ноги
LIQ_CHECK_SEC=5            # перевірка ризику ліквідації кожні 5 с (обидві біржі одночасно)
PROTECT_STOPS=true         # стоп-ордери на самих біржах — спрацюють, навіть якщо бот/сервер упав
STOP_AT_PCT=80             # стоп на біржі на 80% шляху до ліквідації (має бути більше за LIQ_CLOSE_PCT)
RECONCILE_MIN=2            # звірка позицій бота з біржами кожні 2 хв (і при кожному старті)
MAX_DAILY_LOSS_USDT=20     # збиток за день більший — автопауза входів (0 = вимк.)
MAX_LOSS_STREAK=3          # стільки збиткових угод поспіль — автопауза (0 = вимк.)
MAX_ERRORS=5               # стільки помилок ордерів за 10 хв — автопауза (0 = вимк.)
MAX_TOTAL_USDT=0           # макс. сумарна позиція всіх угод (одна нога), USDT (0 = без ліміту)
MAX_EXCHANGE_USDT=0        # макс. сумарна позиція на одній біржі, USDT (0 = без ліміту)
RESERVE_PCT=20             # частка вільного балансу, яку бот ніколи не використовує
MIN_VOLUME_USDT=1000000    # мін. обсяг торгів монети за 24 год на кожній біржі пари
NEW_LISTING_DAYS=3         # не торгувати монети, лістинговані менше N днів тому
DELIST_DAYS=14             # не торгувати монети з делістингом/експірацією в найближчі N днів
MAX_CLOCK_SKEW_MS=1500     # попередження, якщо годинник сервера розходиться з біржами
HEARTBEAT_HOURS=3          # «💓 я працюю» в Telegram кожні N год (0 = вимк.)
SELFTEST_ON_START=true     # live: самоперевірка кожної біржі з ключем при старті; не пройшла — бот на ній не торгує
FUNDING_CONFIRM_SEC=90     # live: не виходити, доки біржа не покаже нарахування фандінгу (максимум N с)
AUTOBAN_LOSSES=3           # монета дала N збиткових угод поспіль — у чорний список (0 = вимк.)
IMBALANCE_RATIO=2          # попередити, якщо на одній біржі в N разів більше грошей, ніж на іншій (0 = вимк.)
LOCK_FILE=data/bot.lock    # захист від запуску двох копій бота
LOG_TO_FILE=true           # журнал у файл logs/bot-РРРР-ММ-ДД.log (без ключів — можна надсилати розробнику)

# --- Перевірка монет з однаковою назвою ---
COIN_PRICE_TOL_PCT=3       # ціни на біржах відрізняються більше — вважаємо різними монетами
STRICT_COINS=false         # true = торгувати лише монети з однаковою адресою контракту на обох біржах
COINS_FILE=data/coins.json # ручні рішення /coinban /coinok

# --- Фільтри монет ---
WHITELIST=                 # напр. BTC,ETH,SOL (порожньо = усі)
BLACKLIST=

SCAN_INTERVAL_SEC=30         # оновлення ставок усіх бірж
TICK_SEC=5                   # перевірка таймінгів входу/виходу
TOP_N_LOG=10
STATE_FILE=data/state.json

# Telegram: керування і звіти. Токен — у @BotFather, свій chat id — у @userinfobot.
# Команди приймаються ТІЛЬКИ з цих чатів (можна кілька через кому)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PIN=              # PIN для небезпечних дій: ключі, налаштування, закриття позицій, /resume (рекомендовано!)

# Щоденний звіт
REPORT_TIME=23:55
TIMEZONE=Europe/Kyiv

# Налаштування, змінені через Telegram, зберігаються тут і мають пріоритет над .env
SETTINGS_FILE=data/settings.json
KEYS_FILE=data/keys.json      # ключі, додані через Telegram (права 600, не комітиться)
KEYS_SECRET=                  # пароль шифрування data/keys.json (AES-256-GCM). Зберігайте окремо від резервних копій data/
