# paper = симуляція (ордери НЕ ставляться), live = реальна торгівля
MODE=paper

# Біржі через кому (id з ccxt): binance, bybit, okx, bitget, gate, mexc, kucoinfutures, ...
EXCHANGES=binance,bybit,okx,bitget,gate
QUOTE=USDT

# API-ключі (потрібні лише для live). Права: торгівля ф'ючерсами. БЕЗ права на виведення!
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=
GATE_API_KEY=
GATE_SECRET=

# --- Розмір і ризик ---
# coins — вхід і вихід фіксованою КІЛЬКІСТЮ МОНЕТ (COIN_QTY), usdt — сумою POSITION_USDT
SIZE_MODE=coins
COIN_QTY=BTC:0.002,ETH:0.05,SOL:1   # у режимі coins бот торгує лише ці монети
POSITION_USDT=100          # номінал КОЖНОЇ ноги (для SIZE_MODE=usdt)
LEVERAGE=3
MARGIN_MODE=isolated
MAX_POSITIONS=3

# --- Вхід ---
MIN_SPREAD_8H_PCT=0.05     # ВХІД лише якщо різниця фандінгу між біржами більша за цей %, за 8 год
HOLD_HOURS_ESTIMATE=24     # горизонт, за який має окупитися вхід
MIN_EXPECTED_PROFIT_PCT=0.1  # мін. чистий очікуваний профіт за цей горизонт (після комісій)
MAX_ENTRY_BASIS_PCT=0.15   # макс. несприятлива різниця цін між біржами
MAX_SLIPPAGE_PCT=0.1
MIN_MINUTES_TO_FUNDING=0
MAX_ABS_FUNDING_RATE_PCT=2 # відсікає аномальні ставки (делістинги тощо)
DEFAULT_TAKER_FEE_PCT=0.05

# --- Вихід ---
EXIT_SPREAD_8H_PCT=0.01
MAX_HOLD_HOURS=72
LIQ_BUFFER_PCT=15          # закрити пару, якщо до ліквідації будь-якої ноги < 15%

# --- Фільтри монет ---
WHITELIST=                 # напр. BTC,ETH,SOL (порожньо = усі)
BLACKLIST=

SCAN_INTERVAL_SEC=60
TOP_N_LOG=10
STATE_FILE=data/state.json

# Telegram: керування і звіти. Токен — у @BotFather, свій chat id — у @userinfobot.
# Команди приймаються ТІЛЬКИ з цих чатів (можна кілька через кому)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Щоденний звіт
REPORT_TIME=23:55
TIMEZONE=Europe/Kyiv

# Налаштування, змінені через Telegram, зберігаються тут і мають пріоритет над .env
SETTINGS_FILE=data/settings.json
